# ASP.NET Core configuration key; keep the real value in the environment or secret store.
ConnectionStrings__Xinobi=

# Optional overrides; local development defaults to this API automatically.
# Next.js reads apps/web/.env.local; Vite reads apps/admin/.env.local.
NEXT_PUBLIC_COMMERCE_API_URL=http://127.0.0.1:5003/api/v1/local-commerce
VITE_COMMERCE_API_URL=http://127.0.0.1:5003/api/v1/local-commerce

# Server only. Never use NEXT_PUBLIC_ or VITE_ prefixes for credentials.
Cloudflare__AccountId=
Cloudflare__ApiToken=
DesignStudio__DailyGenerationLimit=30
