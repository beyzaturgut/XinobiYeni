  "type": {
    "family": "Inter, system-ui, sans-serif",
    "displayWeight": 400,
    "headingWeight": 500,
    "bodyWeight": 400,
    "trackingTight": "-0.035em",
    "headerFamily": "Jost",
    "headerWeight": 300
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius": {
    "small": 6,
    "medium": 12,
    "large": 24,
    "pill": 999
