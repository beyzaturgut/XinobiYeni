{
  "$schema": "https://schemas.xinobi.local/design-tokens/v1.json",
  "version": "0.3.0",
  "theme": "Sessiz teknoloji",
  "color": {
    "ink": "#16242A",
    "muted": "#52605D",
    "canvas": "#F3F3EF",
    "surface": "#FFFFFF",
    "deep": "#101B20",
    "teal": "#0B6C68",
    "tealHover": "#085954",
    "line": "#D8DEDC",
    "focus": "#EFC34A",
    "danger": "#B3261E",
    "success": "#176B45",
    "header": "#000000",
    "onHeader": "#FFFFFF",
    "searchPlaceholder": "#757575"
