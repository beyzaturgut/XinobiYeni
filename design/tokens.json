  "content": {
    "maxWidth": 1440,
    "gutterDesktop": 48,
    "gutterMobile": 20
  },
  "motion": {
    "fast": "160ms",
    "normal": "280ms",
    "reducedMotion": true
  },
  "header": {
    "height": 64,
    "logoHeightDesktop": 44,
    "logoHeightMobile": 40,
    "navFontSize": 16,
    "navLineHeight": 24,
    "searchHeight": 34,
    "searchRadius": 4,
    "iconSize": 24,
    "touchTarget": 44
